{
    "name": "shikifav",
    "description": "Chrome extension (MV3) for quick Shikimori list management: search, statuses, scores, +1 episode",
    "private": true,
    "version": "1.1.0",
    "type": "module",
    "scripts": {
        "dev": "wxt",
        "build": "wxt build",
        "zip": "wxt zip",
        "compile": "vue-tsc --noEmit",
        "size": "node scripts/bundle-size.mjs",
        "lint": "eslint .",
        "format": "prettier --write .",
        "test": "vitest run",
        "postinstall": "wxt prepare"
    },
    "dependencies": {
        "vue": "^3.5.29"
    },
    "devDependencies": {
        "@vue/eslint-config-prettier": "^10.2.0",
        "@vue/eslint-config-typescript": "^14.9.0",
        "@wxt-dev/module-vue": "^1.0.3",
        "eslint": "^10.7.0",
        "eslint-plugin-vue": "^10.9.2",
        "jiti": "^2.7.0",
        "prettier": "^3.9.5",
        "sass": "^1.101.0",
        "typescript": "^5.9.3",
        "vitest": "^4.1.10",
        "vue-tsc": "^3.2.5",
        "wxt": "^0.20.27"
    }
}

WXT_SHIKI_APP_NAME=""
WXT_SHIKI_CLIENT_ID=""
WXT_SHIKI_CLIENT_SECRET=""

# Публичный ключ production-сборки — не секрет, он и так лежит внутри каждой
# сборки. Фиксирует ID расширения, а от ID зависит redirect URI, поэтому
# значение ниже менять незачем — кроме одного случая: магазин выдаёт
# собственный ключ при первой черновой загрузке (docs/06, фаза 9), и тогда
# сюда вписывается он. Значение `none` собирает вообще без ключа — так делается
# та самая первая загрузка. Пустая переменная — ошибка сборки, а не молчаливая
# сборка с другим ID.
WXT_MANIFEST_KEY=""

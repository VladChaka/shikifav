WXT_SHIKI_APP_NAME=""
WXT_SHIKI_CLIENT_ID=""
WXT_SHIKI_CLIENT_SECRET=""

# Анонимная статистика, GA4 Measurement Protocol (фаза 10). Оба поля пустые —
# статистика полностью выключена в коде: ни одного запроса, ни идентификатора.
# Заполняются из свойства GA4: Admin → Data Streams → выбрать поток →
# Measurement Protocol API secrets. api_secret попадает в бандл и спрятать его
# там нельзя — он позволяет только писать события в свойство, но не читать их.
WXT_GA4_MEASUREMENT_ID=""
WXT_GA4_API_SECRET=""

# Публичный ключ сборки — не секрет, он и так лежит внутри каждой. Фиксирует ID
# расширения, а от ID зависит redirect URI.
#
# По умолчанию `none`: сборка без ключа, ID выводится из пути к папке. Так и
# нужно тому, кто собирает проект себе — своё OAuth-приложение он всё равно
# заводит, и redirect URI берёт из chrome.identity.getRedirectURL() уже своей
# сборки. Ключ издателя сюда не подставлен намеренно: с ним ваша сборка
# претендовала бы на идентификатор опубликованного расширения, и Chrome
# отказался бы ставить её рядом с версией из магазина.
#
# Значение имеет смысл менять в одном случае: у вас есть собственный ключ и
# нужен стабильный ID между машинами. Пустая переменная — ошибка сборки, а не
# молчаливая сборка с другим ID.
WXT_MANIFEST_KEY="none"

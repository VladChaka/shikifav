WXT_SHIKI_APP_NAME=""
WXT_SHIKI_CLIENT_ID=""
WXT_SHIKI_CLIENT_SECRET=""

# Анонимная статистика, GA4 Measurement Protocol (фаза 10). Оба поля пустые —
# статистика полностью выключена в коде: ни одного запроса, ни идентификатора.
# Заполняются из свойства GA4: Admin → Data Streams → выбрать поток →
# Measurement Protocol API secrets. api_secret попадает в бандл и спрятать его
# там нельзя — он позволяет только писать события в свойство, но не читать их.
WXT_GA4_MEASUREMENT_ID=""
WXT_GA4_API_SECRET=""

# Публичный ключ production-сборки — не секрет, он и так лежит внутри каждой
# сборки. Фиксирует ID расширения, а от ID зависит redirect URI, поэтому
# значение ниже менять незачем — кроме одного случая: магазин выдаёт
# собственный ключ при первой черновой загрузке (docs/06, фаза 9), и тогда
# сюда вписывается он. Значение `none` собирает вообще без ключа — так делается
# та самая первая загрузка. Пустая переменная — ошибка сборки, а не молчаливая
# сборка с другим ID.
WXT_MANIFEST_KEY=""
